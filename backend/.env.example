# Environment Configuration Example
# Copy this file to .env and update with your actual values

# Application
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
APP_NAME=Bugema University Scholarship System

# Database
# SQLite (Development)
DATABASE_URL=sqlite:///bugema_scholarship.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://username:password@localhost:5432/bugema_scholarship

# MySQL (Alternative)
# DATABASE_URL=mysql://username:password@localhost:3306/bugema_scholarship

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-here

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@bugemauniv.ac.ug

# Redis (for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# File Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Application Settings
MINIMUM_GPA_SCHOLARSHIP=3.0
MINIMUM_GPA_BURSARY=2.5
DEFAULT_SCHOLARSHIP_AMOUNT=2000000
DEFAULT_BURSARY_AMOUNT=1500000
